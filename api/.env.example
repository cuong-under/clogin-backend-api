# ===== Clogin Backend API — biến môi trường bắt buộc =====
# Copy file này thành .env và điền giá trị thật. KHÔNG commit file .env.

# Cổng HTTP server.
PORT=3000

# Kết nối PostgreSQL (Prisma).
DATABASE_URL="postgres://user:password@host:5432/clogin"

# Đặt production khi deploy. Thiếu biến này, server KHÔNG dùng secret
# fallback nữa và sẽ từ chối khởi động (fail-fast).
NODE_ENV=production

# BẮT BUỘC trong production — sinh bằng: openssl rand -hex 32
JWT_SECRET="replace-with-strong-random-hex-64"
ADMIN_JWT_SECRET="replace-with-strong-random-hex-64"

# Secret ký tool grant workspace AI (tách biệt khỏi JWT).
WORKSPACE_AI_GRANT_SECRET="replace-with-strong-random-hex-64"

# Khoá mã hoá Proxy Vault + cookie cloud profile. Chấp nhận hex 64 ký tự
# (32 bytes entropy — khuyến nghị) hoặc chuỗi thô đúng 32 bytes (legacy).
PROXY_VAULT_MASTER_KEY="replace-with-strong-random-hex-64"

# Tài khoản super admin khởi tạo.
ADMIN_DEFAULT_EMAIL="admin@clogin.nghemmo.com"

# Mật khẩu cho super admin lần ĐẦU seed (chỉ dùng khi DB chưa có admin).
# Nếu không set, migrate sẽ sinh random và in 1 lần ra console.
# ADMIN_INITIAL_PASSWORD="replace-with-strong-password"

# Origin được phép gọi API quản trị bằng cookie session (phân tách dấu phẩy).
# Mặc định: https://clogin.nghemmo.com
# ADMIN_ALLOWED_ORIGINS="https://clogin.nghemmo.com,https://api-clogin.nghemmo.com"

# GitHub fine-grained token cho tính năng Release/Upstream sync trong
# Admin Portal (Contents: RW, Actions: RW). Có thể lưu qua Portal thay vì .env.
# GITHUB_TOKEN="github_pat_..."
