# Cổng HTTP server.
PORT=3000

# Kết nối PostgreSQL (Prisma).
DATABASE_URL="postgres://user:password@host:5432/clogin"

# BẮT BUỘC ở production (NODE_ENV=production). Ở môi trường dev/test nếu
# thiếu sẽ dùng fallback nội bộ. Sinh bằng: openssl rand -hex 32
JWT_SECRET="replace-with-strong-random-hex-64"
ADMIN_JWT_SECRET="replace-with-strong-random-hex-64"

# Tài khoản super admin mặc định (chỉ tạo khi chưa tồn tại).
ADMIN_DEFAULT_EMAIL="admin@clogin.nghemmo.com"
ADMIN_DEFAULT_PASSWORD="replace-with-strong-password"
