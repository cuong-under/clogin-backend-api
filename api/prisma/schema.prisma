generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id             String    @id @default(uuid())
  email          String    @unique
  password_hash  String
  name           String    @default("")
  role           AdminRole @default(viewer)
  active         Boolean   @default(true)
  last_login_at  DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  @@map("admin_users")
}

enum AdminRole {
  super_admin
  support
  viewer
}

model LicensePlan {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  max_devices    Int       @default(1)
  max_workers    Int       @default(3)
  max_profiles   Int       @default(100)
  features       Json      @default("[]")
  price_vnd      Int       @default(0)
  duration_days  Int?
  active         Boolean   @default(true)
  sort_order     Int       @default(0)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  licenses       License[]
  @@map("license_plans")
}

model License {
  id             String        @id @default(uuid())
  key            String        @unique
  plan_id        String?
  plan           LicensePlan?  @relation(fields: [plan_id], references: [id])
  plan_name      String        @default("Standard")
  max_devices    Int           @default(1)
  status         LicenseStatus @default(active)
  expires_at     DateTime?
  suspended_at   DateTime?
  suspend_reason String?
  notes          String        @default("")
  coupon_code    String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  devices        Device[]
  owner          Owner?
  @@index([status])
  @@index([expires_at])
  @@map("licenses")
}

enum LicenseStatus {
  active
  expired
  suspended
  revoked
}

model Device {
  id             String   @id @default(uuid())
  license_id     String
  license        License  @relation(fields: [license_id], references: [id], onDelete: Cascade)
  hwid           String
  device_name    String   @default("Desktop PC")
  ip_address     String?
  last_seen_at   DateTime @default(now())
  activated_at   DateTime @default(now())
  @@unique([license_id, hwid])
  @@map("devices")
}

model Owner {
  id               String         @id @default(uuid())
  email            String         @unique
  password_hash    String
  name             String         @default("")
  license_id       String?        @unique
  license          License?       @relation(fields: [license_id], references: [id])
  max_worker_slots Int            @default(3)
  active           Boolean        @default(true)
  last_login_at    DateTime?
  last_login_ip    String?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  workers          Worker[]
  profiles         CloudProfile[]
  audit_logs       AuditLog[]
  workspaces       Workspace[]
  @@index([email])
  @@map("owners")
}

model Worker {
  id             String    @id @default(uuid())
  owner_id       String
  owner          Owner     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  email          String
  password_hash  String
  name           String    @default("")
  active         Boolean   @default(true)
  last_login_at  DateTime?
  last_login_ip  String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  workspaceMembers   WorkspaceMember[]
  profileAssignments WorkspaceProfileAssignment[]
  @@unique([owner_id, email])
  @@index([email])
  @@map("workers")
}

model CloudProfile {
  id                  String    @id
  owner_id            String
  owner               Owner     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  name                String
  folder              String    @default("")
  config              Json      @default("{}")
  cookies             Json?
  assigned_worker_ids String[]  @default([])
  sync_revision       Int       @default(0)
  sync_state          String    @default("pending")
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  workspaceProfiles   WorkspaceProfile[]
  @@index([owner_id])
  @@map("cloud_profiles")
}

model AuditLog {
  id          String    @id @default(uuid())
  owner_id    String?
  owner       Owner?    @relation(fields: [owner_id], references: [id], onDelete: SetNull)
  user_id     String
  user_type   String
  user_name   String
  action      String
  target      String    @default("")
  ip_address  String?
  user_agent  String?
  metadata    Json?
  timestamp   DateTime  @default(now())
  @@index([owner_id])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

model LoginHistory {
  id          String   @id @default(uuid())
  user_id     String
  user_type   String
  email       String
  ip_address  String
  user_agent  String?
  country     String?
  success     Boolean  @default(true)
  fail_reason String?
  created_at  DateTime @default(now())
  @@index([user_id])
  @@index([email])
  @@index([created_at])
  @@map("login_history")
}

model Release {
  id               String         @id @default(uuid())
  version          String         @unique
  channel          ReleaseChannel @default(stable)
  changelog        String         @default("")
  download_url     String?
  update_signature String?        @db.Text
  min_version      String?
  is_current       Boolean        @default(false)
  build_status     String         @default("draft")
  build_run_id     String?
  build_commit_sha String?
  source_branch    String?
  build_error      String?
  build_started_at DateTime?
  published_at     DateTime       @default(now())
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  @@index([channel, is_current])
  @@map("releases")
}

enum ReleaseChannel {
  stable
  beta
  canary
}

model Announcement {
  id           String    @id @default(uuid())
  title        String
  body         String
  type         String    @default("info")
  target       String    @default("all")
  active       Boolean   @default(true)
  starts_at    DateTime  @default(now())
  ends_at      DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  @@map("announcements")
}

model SystemConfig {
  key        String   @id
  value      Json
  updated_at DateTime @updatedAt
  @@map("system_config")
}

model FeatureFlag {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  description  String   @default("")
  enabled      Boolean  @default(true)
  target_plans String[] @default([])
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  @@map("feature_flags")
}

model Coupon {
  id               String    @id @default(uuid())
  code             String    @unique
  discount_percent Int       @default(0)
  plan_id          String?
  max_uses         Int       @default(1)
  used_count       Int       @default(0)
  active           Boolean   @default(true)
  expires_at       DateTime?
  created_at       DateTime  @default(now())
  @@map("coupons")
}

model IpBlock {
  id         String    @id @default(uuid())
  ip         String    @unique
  reason     String    @default("")
  expires_at DateTime?
  created_at DateTime  @default(now())
  @@map("ip_blocks")
}

enum WorkspacePresetRole {
  operator
  manager
  auditor
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskStatus {
  todo
  in_progress
  blocked
  done
  cancelled
}

enum AiActionClass {
  read
  write
  destructive
  sensitive
}

model Workspace {
  id              String    @id @default(uuid())
  owner_id        String
  owner           Owner     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  name            String
  description     String    @default("")
  archived_at     DateTime?
  policy_revision Int       @default(1)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  members         WorkspaceMember[]
  profiles        WorkspaceProfile[]
  sops            SopTemplate[]
  tasks           WorkspaceTask[]
  auditEvents     WorkspaceAuditEvent[]
  vaultEntries    ProxyVaultEntry[]
  @@index([owner_id])
  @@map("workspaces")
}

model WorkspaceMember {
  id             String               @id @default(uuid())
  workspace_id   String
  workspace      Workspace            @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  worker_id      String
  worker         Worker               @relation(fields: [worker_id], references: [id], onDelete: Cascade)
  preset_role    WorkspacePresetRole
  capabilities   String[]             @default([])
  active         Boolean              @default(true)
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  profileAssignments WorkspaceProfileAssignment[]
  @@unique([workspace_id, worker_id])
  @@index([worker_id])
  @@map("workspace_members")
}

model WorkspaceProfile {
  id            String    @id @default(uuid())
  workspace_id  String
  workspace     Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  profile_id    String
  profile       CloudProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  vault_proxy_id  String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  assignments   WorkspaceProfileAssignment[]
  taskLinks     TaskProfile[]
  @@unique([workspace_id, profile_id])
  @@index([profile_id])
  @@map("workspace_profiles")
}

model WorkspaceProfileAssignment {
  id                    String            @id @default(uuid())
  workspace_profile_id  String
workspace_profile    WorkspaceProfile  @relation(fields: [workspace_profile_id], references: [id], onDelete: Cascade)
  member_id            String?
  member               WorkspaceMember?  @relation(fields: [member_id], references: [id], onDelete: Cascade)
  worker_id            String
  worker               Worker            @relation(fields: [worker_id], references: [id], onDelete: Cascade)
  created_at           DateTime          @default(now())
  @@unique([workspace_profile_id, worker_id])
  @@index([worker_id])
  @@map("workspace_profile_assignments")
}

model SopTemplate {
  id              String   @id @default(uuid())
  workspace_id    String
  workspace       Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  name            String
  version         String
  content_markdown String  @default("")
  checklist       Json     @default("[]")
  is_active       Boolean  @default(false)
  created_by      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  tasks           WorkspaceTask[]
  @@unique([workspace_id, name, version])
  @@index([workspace_id, is_active])
  @@map("sop_templates")
}

model WorkspaceTask {
  id              String       @id @default(uuid())
  workspace_id    String
  workspace       Workspace    @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  title           String
  description     String       @default("")
  objective       String       @default("")
  priority        TaskPriority @default(medium)
  status          TaskStatus   @default(todo)
  assignee_type   String       @default("worker")
  assignee_id     String
  sop_id          String?
  sop_version     String?
  sop_snapshot    Json?
  sop             SopTemplate? @relation(fields: [sop_id], references: [id], onDelete: SetNull)
  due_at          DateTime?
  started_at      DateTime?
  completed_at    DateTime?
  created_by      String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  profiles        TaskProfile[]
  @@index([workspace_id, status])
  @@index([workspace_id, assignee_type, assignee_id])
  @@index([due_at])
  @@map("workspace_tasks")
}

model TaskProfile {
  task_id              String          @id
  workspace_profile_id String
  task                 WorkspaceTask   @relation(fields: [task_id], references: [id], onDelete: Cascade)
  workspace_profile    WorkspaceProfile @relation(fields: [workspace_profile_id], references: [id], onDelete: Cascade)
  created_at           DateTime        @default(now())
  @@unique([task_id, workspace_profile_id])
  @@map("task_profiles")
}

model WorkspaceAuditEvent {
  id               String         @id @default(uuid())
  owner_id         String
  workspace_id     String
  workspace        Workspace      @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  actor_id         String
  actor_type       String         @default("user")
  actor_name       String         @default("")
  user_role        String         @default("")
  policy_mode      String         @default("ask")
  tool_name        String         @default("")
  capability       String         @default("")
  action_class     String         @default("")
  target_id        String         @default("")
  confirmed        Boolean        @default(false)
  status           String         @default("")
  correlation_id   String?
  parameter_digest String?
  result_digest    String?
  ip_address       String?
  created_at       DateTime       @default(now())
  @@index([workspace_id, created_at])
  @@index([workspace_id, actor_id])
  @@index([workspace_id, tool_name])
  @@index([correlation_id])
  @@map("workspace_audit_events")
}

model ProxyVaultEntry {
  id                    String    @id @default(uuid())
  workspace_id          String
  workspace             Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  label                 String
  kind                  String    @default("http")
  host                  String
  port                  Int
  country              String    @default("")
  region               String    @default("")
  health_state          String    @default("unknown")
  last_checked_at       DateTime?
  ciphertext            String
  nonce                 String
  tag                   String
  encrypted_dek         String
  dek_nonce             String
  dek_tag               String
  key_version           Int       @default(2)
  credential_fingerprint String   @unique
  created_by            String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  @@index([workspace_id])
  @@index([workspace_id, kind])
  @@map("proxy_vault_entries")
}
